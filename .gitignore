# Python bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Node (frontend only — do not install npm deps in backend/)
node_modules/
backend/node_modules/

# Data and Models (Crucial for Vision AI projects)
*.pt
*.engine
data/videos/*
data/outputs/*
data/clips/*
models/*.pt
models/*.onnx
models/*.engine

# Keep yolo11n.onnx tracked — needed for Render deployment (no torch on server)
!backend/yolo11n.onnx

# Keep the data directories tracked but empty
!data/videos/.gitkeep
!data/outputs/.gitkeep
!data/clips/.gitkeep
!models/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
.env
