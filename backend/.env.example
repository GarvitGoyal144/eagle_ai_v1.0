# ==========================================
# Eagle AI Configuration
# ==========================================

PROJECT_NAME=Eagle AI
PROJECT_VERSION=1.0.0

HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated, use * for public API access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=eagle_ai

UPLOAD_FOLDER=data/videos
OUTPUT_FOLDER=data/outputs
CLIP_FOLDER=data/clips

# Vision Models & Trackers (yolo11n.pt is 5.6MB, optimal for CPU)
YOLO_MODEL=yolo11n.pt
TRACKER=botsort.yaml
CLIP_MODEL=ViT-B-16-SigLIP-2

# LLM Configuration (groq = $0 free cloud LLM | ollama = local)
LLM_PROVIDER=groq
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# Compute Device (cpu | cuda)
DEVICE=cpu

# Performance & Throttling
INFERENCE_SIZE=480
INFERENCE_FPS=8
DETECTION_CONF=0.4
STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_JPEG_QUALITY=72

CLIP_SCENE_INTERVAL=3.0
CLIP_CROP_MIN_SIZE=40
DISABLE_CLIP=false

# Search
SEARCH_TOP_K=5

LOG_LEVEL=INFO